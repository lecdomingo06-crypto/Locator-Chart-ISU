APP_NAME="Professor Tracking System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_database_name
DB_USERNAME=cpanel_database_user
DB_PASSWORD=replace_with_database_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_with_gmail_address
MAIL_PASSWORD=replace_with_new_gmail_app_password
MAIL_FROM_ADDRESS=replace_with_gmail_address
MAIL_FROM_NAME="${APP_NAME}"

GEMINI_API_KEY=replace_with_new_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

HCAPTCHA_SITEKEY=replace_with_hcaptcha_site_key
HCAPTCHA_SECRET=replace_with_hcaptcha_secret_key

ADMIN_INITIAL_PASSWORD=replace_with_a_unique_12_character_password

ATTENDANCE_GEOFENCE_ENABLED=true
ATTENDANCE_GEOFENCE_LATITUDE=16.987778
ATTENDANCE_GEOFENCE_LONGITUDE=121.718611
ATTENDANCE_GEOFENCE_RADIUS_METERS=75
ATTENDANCE_GEOFENCE_MAX_ACCURACY_METERS=150
VITE_APP_NAME="${APP_NAME}"